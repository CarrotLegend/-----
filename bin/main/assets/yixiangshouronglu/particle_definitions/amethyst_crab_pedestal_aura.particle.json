{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "yixiangshouronglu:amethyst_crab_pedestal_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "yixiangshouronglu:amethyst_crab_pedestal_aura"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 60,
        "max_particles": 100
      },
      "minecraft:emitter_lifetime_expression": {},
      "minecraft:emitter_shape_sphere": {
        "radius": 2,
        "direction": "outwards"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "v.size = (1 - v.particle_age / v.particle_lifetime) * (0.05 + 0.05 * v.particle_random_1);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(-180, 180)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          4,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size",
          "v.size"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#ffffffff",
            "0.24": "#FF6F00FF",
            "1.0": "#000036FF"
          }
        }
      }
    }
  }
}
